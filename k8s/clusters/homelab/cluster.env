# The cluster's addresses. To move the cluster to another network, change them
# here and in nodes.conf; nothing else names an address. Read by
# scripts/render-butane.sh and scripts/pve.sh.
#
# Plain KEY=value lines: no quotes, no spaces.

# The LAN the nodes are on
LAN_PREFIX_LEN=24
LAN_GATEWAY=192.168.1.1
DNS_SERVERS=1.1.1.1,8.8.8.8

# kube-apiserver's virtual IP, held by one control plane node (keepalived).
# A free address on the LAN.
API_VIP=192.168.1.20

# Must not overlap the LAN or each other
POD_CIDR=100.100.0.0/16
SERVICE_CIDR=172.16.0.0/16

# Not read from here yet: the workloads under k8s/ still name their own
# addresses. Until they do, a change above needs the same change there:
#   API_VIP   -> k8sServiceHost in k8s/infrastructure/controllers/cilium/values.yaml
#   POD_CIDR  -> podCIDRs in k8s/infrastructure/controllers/zora/helmrelease.yaml
# The LoadBalancer range (k8s/infrastructure/configs/cilium/lb-ippool.yaml) and
# Pi-hole's address (k8s/apps/pihole/service.yaml) are on the LAN too.
