# The cluster's addresses. To move the cluster to another network, change them
# here and in nodes.conf; nothing else names an address.
#
# Read by the node build (scripts/render-butane.sh, scripts/pve.sh) and by
# Flux, which substitutes ${NAME} in the manifests under k8s/infrastructure
# and k8s/apps (see docs/flux.md).
#
# Plain KEY=value lines: no quotes, no spaces.

# The LAN the nodes are on
LAN_PREFIX_LEN=24
LAN_GATEWAY=192.168.1.1
DNS_SERVERS=1.1.1.1,8.8.8.8

# kube-apiserver's virtual IP, held by one control plane node (keepalived).
# A free address on the LAN.
API_VIP=192.168.1.20

# Must not overlap the LAN or each other
POD_CIDR=100.100.0.0/16
SERVICE_CIDR=172.16.0.0/16

# LoadBalancer Services get an address from this range: free addresses on the
# LAN, outside the router's DHCP pool
LB_RANGE_START=192.168.1.31
LB_RANGE_STOP=192.168.1.40

# Pi-hole's address, which the router hands out as the LAN's DNS server.
# Inside the LoadBalancer range.
PIHOLE_IP=192.168.1.31
